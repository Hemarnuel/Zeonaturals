VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=

# Payment gateway: set PAYSTACK_ENABLED=true to activate Paystack checkout.
# Keep "false" to stay in demo mode (no payment gateway active).
VITE_PAYSTACK_ENABLED=false

# Backend server environment variables:
# Set these in your Vercel project settings (Settings > Environment Variables).
# Test mode (recommended for development):
#   PAYSTACK_SECRET_KEY=sk_test_...
#   VITE_PAYSTACK_PUBLIC_KEY=pk_test_...
# Live mode:
#   PAYSTACK_SECRET_KEY=sk_live_...
#   VITE_PAYSTACK_PUBLIC_KEY=pk_live_...
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SITE_URL=https://your-api-domain.vercel.app

# Paystack test webhook endpoint:
# In your Paystack dashboard (Settings > Webhooks), add:
#   https://your-api-domain.vercel.app/api/paystack/webhook
# and enable the "charge.success" and "charge.failed" events.